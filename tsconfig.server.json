{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] },
    "types": ["@cloudflare/workers-types"]
  },
  "exclude": ["src/domain/__tests__"],
  "include": ["server", "src/domain", "src/lib/dates.ts", "src/lib/types.ts", "src/lib/categories.ts", "src/lib/utils.ts"]
}
